resources/
slprj/
sccprj/
codegen/

# Autosaves and temp
*.asv
*.m~
*.mlx.autosave
*.autosave

# Binaries and platform cruft
*.mex*
*.mat
.DS_Store
"*.prj"          

# Python bytecode
